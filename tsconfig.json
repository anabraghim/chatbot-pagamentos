{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "aws-lambda"]
  },
  "include": ["infra/**/*.ts", "api/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
